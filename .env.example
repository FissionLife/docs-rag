# Get a key at https://aistudio.google.com/apikey
# One key, or several comma-separated -- with more than one, the pipeline
# automatically rotates to the next key when the current one hits its daily
# quota (as low as ~20 generations/day/key on the free tier), instead of
# stopping for the rest of the day. GEMINI_API_KEYS also works, same format,
# if you'd rather keep the names separate.
GEMINI_API_KEY=your_key_here
# GEMINI_API_KEY=key_one,key_two,key_three

# --- Models -------------------------------------------------------------
# RAG_EMBED_MODEL=gemini-embedding-001   # or gemini-embedding-2
# RAG_EMBED_DIM=1536                     # 128-3072, MRL-truncatable
# RAG_GEN_MODEL=gemini-3.6-flash         # gemini-3.5-flash-lite: faster quota, can over-refuse

# Fallback generation models, tried in order, after every configured key is
# exhausted (or the model itself is unavailable, e.g. closed to new keys) for
# the one before it. Off by default -- not auto-set to flash-lite, since its
# over-refusal risk (see RAG_GEN_MODEL above) is a real quality trade a
# fallback should never make silently.
# RAG_GEN_MODEL_FALLBACK=gemini-3.5-flash,gemini-3.5-flash-lite

# --- Rate limits ----------------------------------------------------------
# RAG_EMBED_RPM=95                       # free tier allows 100 texts/minute
# RAG_GEN_RPM=10
# RAG_EMBED_BATCH=32                     # texts per embedding API call
# RAG_EMBED_MAX_RETRIES=6

# --- Chunking ---------------------------------------------------------------
# RAG_CHUNK_CHARS=1400                   # target chunk size, ~350 tokens
# RAG_CHUNK_OVERLAP=200
# RAG_MIN_CHUNK_CHARS=120                # below this, a chunk is a scrap, not kept alone

# Demo only -- flat (default) or hierarchical (RAPTOR-lite, needs its own
# `ingest` to build). See rag/hierarchy.py and README.md.
# RAG_CHUNK_MODE=flat
# RAG_CLUSTER_SIZE=20                    # leaf chunks per cluster in hierarchical mode

# --- Retrieval ----------------------------------------------------------
# RAG_CANDIDATES=30                      # candidates proposed before fusion
# RAG_TOP_K=6                            # chunks actually shown to the generator
# RAG_RRF_K=60                           # reciprocal-rank-fusion constant
# RAG_MMR_LAMBDA=0.7                     # 1.0 = pure relevance, 0.0 = pure diversity
# RAG_DEDUP_COSINE=0.95                  # above this, two chunks are "the same fact twice"
# RAG_MIN_COSINE=0.55                    # below this best match, refuse before generating

# What AWS service-page citations link to: aws (aws.amazon.com) or local (file path)
# RAG_AWS_PAGE_URL=aws
